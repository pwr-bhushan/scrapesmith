{
  "host": "amazon.in",
  "page_type": "product_listing",
  "fields": [
    {
      "name": "price",
      "type": "currency",
      "old_selector": "css=[data-price-amount]",
      "dq": {
        "required": true,
        "regex": "[₹$€]\\s*[\\d,]+",
        "parses_as": "number"
      },
      "anchor": "₹1,49,900"
    },
    {
      "name": "title",
      "type": "text",
      "old_selector": "css=.product-title",
      "dq": {
        "required": true,
        "regex": ".+",
        "parses_as": "text"
      },
      "anchor": "Apple MacBook Pro 14-inch"
    }
  ]
}
