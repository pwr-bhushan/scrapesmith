# Copy to .env.local and edit. Gitignored — the one place for config and secrets.
#
# Loaded into the process environment by app/config.py, so everything picks it up: the
# Settings model, the anthropic SDK (which reads ANTHROPIC_API_KEY itself), and the direct
# os.environ reads in the heal providers. A real environment variable always wins over this
# file, so container-injected secrets keep working.

# --- Data stores -----------------------------------------------------------------
# Defaults are convenience credentials for a local Postgres. check_settings() refuses them
# whenever SCRAPESMITH_ENV is anything other than "local".
SCRAPESMITH_DATABASE_URL=postgresql+asyncpg://scrapesmith:scrapesmith@localhost:5432/scrapesmith
SCRAPESMITH_REDIS_URL=redis://localhost:6379

# --- Environment -----------------------------------------------------------------
# "local" (default) allows the dev defaults above. Set to anything else — "staging",
# "production" — and the app refuses to start until the database URL is a real one.
SCRAPESMITH_ENV=local

# --- Heal + inference model (both optional) --------------------------------------
# Provider selection, in order: ANTHROPIC_API_KEY wins, then OLLAMA_HOST, then neither —
# in which case heal still detects and clusters drift, it just cannot propose selectors.
# OLLAMA_HOST=http://localhost:11434
# ANTHROPIC_API_KEY=sk-ant-...
# SCRAPESMITH_CLOUD_MODEL=claude-haiku-4-5

# --- Frontend --------------------------------------------------------------------
# Not read from this file. NEXT_PUBLIC_API_BASE is compiled into the browser bundle at build
# time, so it is public by definition and lives in frontend/.env.local — kept apart from the
# secrets above on purpose.
